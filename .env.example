# =====================================================================
# Sproutern-Hermes — Environment Variables
# Copy this file to `.env.local` and fill in your real values.
# ALL variables are OPTIONAL — the site builds and runs with none set.
# =====================================================================

# ---------------------------------------------------------------------
# FIREBASE (OPTIONAL — only needed for login/AI/storage features)
# Leave blank to run as a static content + monetization site.
# The app uses safe placeholders when these are absent, so the build
# never fails.
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------
# GOOGLE GENKIT AI (OPTIONAL — AI resume tools)
# Without this, AI features gracefully return "unavailable".
# ---------------------------------------------------------------------
GOOGLE_API_KEY=

# ---------------------------------------------------------------------
# MONETIZATION — DISPLAY ADS
# Keep REVIEW_MODE=true until AFTER AdSense approves your site.
# Flipping it to false before approval can get you rejected.
# ---------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_REVIEW_MODE=true
NEXT_PUBLIC_ADSENSE_ACCOUNT=ca-pub-0000000000000000
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_ID=0000000000
NEXT_PUBLIC_EZOIC_VERIFICATION=

# ---------------------------------------------------------------------
# MONETIZATION — DONATIONS (UPI for India)
# Set your own UPI handle to receive donations.
# ---------------------------------------------------------------------
NEXT_PUBLIC_UPI_ID=YOUR_UPI_ID@paytm

# ---------------------------------------------------------------------
# ANALYTICS (OPTIONAL)
# ---------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_AHREFS_KEY=
NEXT_PUBLIC_CLOUDFLARE_BEACON_TOKEN=
